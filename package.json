{
  "name": "bugdeloi",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*",
    "replications/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "check": "bun run --filter '*' check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "db:generate": "bun run --filter @bugdeloi/db generate",
    "db:migrate": "bun run --filter @bugdeloi/db migrate",
    "impeccable": "impeccable detect apps/web/src",
    "verify": "bun run check && biome check . && bun run impeccable && bun test",
    "check:oracles": "bun scripts/check-oracles.ts",
    "check:n4": "bun scripts/check-n4.ts",
    "audit:analyses": "bun scripts/audit-analyses.ts",
    "smoke:web": "bun scripts/smoke-web.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "1.4.5",
    "impeccable": "^4.11.1",
    "typescript": "7.0.2"
  }
}
