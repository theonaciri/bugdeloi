{
  "name": "bugdeloi",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "check": "bun run --filter '*' check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "db:generate": "bun --cwd packages/db run generate",
    "db:migrate": "bun --cwd packages/db run migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
