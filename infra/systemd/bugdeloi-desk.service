[Unit]
Description=BugDeLoi - reconstitution de la réserve du guichet
After=postgresql.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/.local/share/bugdeloi/current
Environment=DATABASE_URL=postgres://ubuntu@localhost:5432/bugdeloi?host=/var/run/postgresql
ExecStart=/home/ubuntu/.bun/bin/bun apps/web/scripts/seed-desk.ts
TimeoutStartSec=1min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX
