déclaration champ d'application TestZero:
  c champ d'application CalculImpôtRevenu

champ d'application TestZero:
  # source : CGI article 197 I.1, revenu nul.
  définition c.revenu_net_imposable égal à 0€
  définition c.situation_familiale égal à Célibataire
  définition c.enfants_à_charge_exclusive_ou_principale égal à 0
  définition c.appréciation_vit_seul égal à faux
  définition c.domicile_fiscal égal à Métropole
