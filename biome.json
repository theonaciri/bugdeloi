{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/migrations",
      "!**/.svelte-kit",
      "!**/build",
      "!replications/**/raw",
      "!.agent",
      "!.agents",
      "!.claude"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "overrides": [
    {
      "includes": ["**/*.svelte"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } } }
    }
  ]
}
